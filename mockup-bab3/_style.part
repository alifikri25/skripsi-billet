<helmet>
  <style>
    body { margin:0; background:#fff; color:#16181d;
      font-family:"Segoe UI", system-ui, -apple-system, "Helvetica Neue", sans-serif;
      -webkit-font-smoothing:antialiased; }
    a { color:#16181d; } a:hover { color:#4a4f57; }
    .fig { padding:34px 38px 38px; }
    .fig-h { border-bottom:2px solid #16181d; padding-bottom:9px;
      display:flex; align-items:baseline; justify-content:space-between; gap:16px; }
    .fig-t { font-size:15px; font-weight:700; letter-spacing:.14em; text-transform:uppercase; }
    .fig-s { font-size:10px; letter-spacing:.11em; text-transform:uppercase; color:#7b818a; }
    .fig-d { font-size:11.5px; color:#4a4f57; line-height:1.55; margin:11px 0 20px; max-width:800px; }
    .scr { position:relative; border:1px solid #c9ccd1; background:#fff; }
    .b   { border:1px solid #c9ccd1; }
    .bd  { border:1px dashed #c9ccd1; }
    .ph  { border:1px solid #c9ccd1;
      background:repeating-linear-gradient(45deg,#eceef0 0 7px,#f6f7f8 7px 14px);
      display:flex; align-items:center; justify-content:center;
      font-size:10px; letter-spacing:.12em; text-transform:uppercase; color:#7b818a; }
    .fill{ background:#f1f2f4; }
    .bar { background:#dcdee1; height:7px; }
    .lbl { font-size:10px; letter-spacing:.11em; text-transform:uppercase; color:#7b818a; }
    .lblk{ font-size:10px; letter-spacing:.11em; text-transform:uppercase; color:#16181d; font-weight:600; }
    .h1  { font-size:21px; font-weight:700; letter-spacing:-.01em; text-transform:uppercase; }
    .h2  { font-size:13px; font-weight:700; letter-spacing:.03em; text-transform:uppercase; }
    .tx  { font-size:11px; color:#4a4f57; line-height:1.5; }
    .btn { background:#16181d; color:#fff; font-size:10px; font-weight:600; letter-spacing:.12em;
      text-transform:uppercase; padding:10px 14px; text-align:center; }
    .btno{ border:1px solid #16181d; color:#16181d; font-size:10px; font-weight:600; letter-spacing:.12em;
      text-transform:uppercase; padding:9px 13px; text-align:center; }
    .tag { border:1px solid #c9ccd1; color:#7b818a; font-size:9px; letter-spacing:.1em;
      text-transform:uppercase; padding:3px 7px; }
    .tagk{ background:#16181d; color:#fff; font-size:9px; letter-spacing:.1em;
      text-transform:uppercase; padding:4px 8px; }
    .inp { border:1px solid #c9ccd1; background:#fafbfb; padding:9px 11px; font-size:11px; color:#9aa0a7; }
    .mono{ font-family:"Cascadia Mono", Consolas, ui-monospace, monospace; }
    .n   { position:absolute; width:22px; height:22px; border-radius:50%; background:#16181d; color:#fff;
      font-size:11px; font-weight:700; display:flex; align-items:center; justify-content:center;
      box-shadow:0 0 0 3px #fff; z-index:5; }
    .leg { margin-top:24px; border-top:1px solid #c9ccd1; padding-top:16px; }
    .legt{ font-size:10.5px; font-weight:700; letter-spacing:.14em; text-transform:uppercase; margin-bottom:13px; }
    .legi{ display:flex; gap:9px; align-items:flex-start; }
    .legn{ width:19px; height:19px; border-radius:50%; background:#16181d; color:#fff; font-size:10px;
      font-weight:700; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
    .legx{ font-size:11px; color:#3a3f46; line-height:1.5; }
    .legx b { color:#16181d; font-weight:600; }
  </style>
</helmet>
